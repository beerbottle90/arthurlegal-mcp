# Normalize line endings in the repo so a CRLF working tree never ships CRLF to
# a shell script. Without this, run-public.sh committed from Windows fails on
# macOS/Linux with: bad interpreter: /usr/bin/env bash^M
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.ps1  text eol=crlf
